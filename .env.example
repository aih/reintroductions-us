# Copy to .env (gitignored), chmod 600, and pass with `uv run --env-file .env …`.
# docs/api-tokens.md has the whole procedure.

# Tokens issued by uscode.linkedlegislation.org and statutes.linkedlegislation.org,
# sent as `Authorization: Bearer`. Unset, the checks run within the anonymous limits.
USCODE_API_TOKEN=
STATUTES_API_TOKEN=

# REINTRO_DB=data/reintro.db
# REINTRO_CACHE=data/cache
# REINTRO_CHECKS=on
